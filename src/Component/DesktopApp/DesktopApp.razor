@namespace Orchid.Desktop.Component
@using Orchid.Desktop.Service
@inject IOrchidDesktopAuthService AuthService
@inject IStringLocalizer<DesktopAppResource> Localizer
@inject DesignSystem DesignSystem
@implements IDisposable

<OrchidDesktopDesignSystemProvider @ref="_provider" />
<MudThemeProvider Theme="_provider?.CurrentMudTheme" IsDarkMode="@(_provider?.IsDarkMode ?? false)" />
<MudDialogProvider />
<GardenSnackbarProvider />
<MudPopoverProvider />

<div class="orchid-desktop-shell">
    <GardenTopAppBar Height="16"
                     PaddingHorizontal="4"
                     PaddingVertical="1">
        <LeadingContent>
            <MudIcon Icon="@Icons.Material.Filled.ContentPasteGo"
                     Style="margin-right: var(--gdn-sys-spacing-2);" />
            <GardenTypography HtmlTag="h1"
                              Typo="TypographyStyle.Title"
                              Size="TypographySize.Large"
                              Style="margin-right: var(--gdn-sys-spacing-4); font-weight: 600; white-space: nowrap;">
                @Localizer[nameof(DesktopAppResource.AppName)]
            </GardenTypography>
        </LeadingContent>
        <TrailingContent>
            <div style="display: flex; align-items: center; gap: 12px;">
                <GardenChipAssist Label="AES-256-GCM"
                                  Variant="GardenChipAssistVariant.Outlined" />
                <GardenIconButton Icon="@((_provider?.IsDarkMode ?? false) ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                  Variant="GardenIconButtonVariant.Standard"
                                  Size="GardenIconButtonSize.Small"
                                  aria-label="테마 전환"
                                  title="Light/Dark 테마 전환"
                                  OnClick="ToggleTheme" />
                @if (AuthService.IsAuthenticated)
                {
                    <GardenAccountMenu DisplayName="@AuthService.CurrentUserName"
                                       Email="@AuthService.CurrentUserEmail"
                                       SignOutLabel="@Localizer[nameof(DesktopAppResource.SignOutLabel)]"
                                       OnSignOutRequested="SignOutAsync" />
                }
            </div>
        </TrailingContent>
    </GardenTopAppBar>

    <main style="padding: 16px; display: flex; flex-direction: column; gap: 16px;">
        @if (!AuthService.IsAuthenticated)
        {
            <LoginPanel OnAuthenticated="StateHasChanged" />
        }
        else
        {
            <PairingPanel />
            <ClipboardList />
        }
    </main>
</div>

@code {
    private OrchidDesktopDesignSystemProvider? _provider;

    protected override void OnInitialized()
    {
        DesignSystem.Color.SchemeSet.ContextChanged += OnSchemeContextChanged;
    }

    private void ToggleTheme(MouseEventArgs args)
    {
        _provider?.ToggleTheme();
        StateHasChanged();
    }

    private void OnSchemeContextChanged(object? sender, SchemeContextChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SignOutAsync(MouseEventArgs args)
    {
        await AuthService.SignOutAsync();
    }

    public void Dispose()
    {
        DesignSystem.Color.SchemeSet.ContextChanged -= OnSchemeContextChanged;
    }
}
