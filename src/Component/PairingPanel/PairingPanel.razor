@namespace Orchid.Desktop.Component
@using Orchid.Core.Sync
@using Orchid.Core.Sync.Relay
@inject ClipboardSyncCoordinator Coordinator
@inject IStringLocalizer<PairingPanelResource> Localizer

<GardenCard Type="GardenCardType.Elevated" Style="padding: 24px; display: flex; flex-direction: column; gap: 12px;">
    <GardenTypography HtmlTag="h2" Typo="TypographyStyle.Title" Size="TypographySize.Medium">
        @Localizer[nameof(PairingPanelResource.Title)]
    </GardenTypography>
    @if (_payload is null)
    {
        <div>
            <GardenButton Variant="GardenButtonVariant.Filled" Size="GardenButtonSize.Small" OnClick="StartAsync">
                @Localizer[nameof(PairingPanelResource.StartPairing)]
            </GardenButton>
        </div>
    }
    else
    {
        <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
            @Localizer[nameof(PairingPanelResource.ScanOrEnterKeyGuide)]
        </GardenTypography>
        <GardenTextField Value="@_payload" ReadOnly="true" Label="@Localizer[nameof(PairingPanelResource.PairingKeyLabel)]" />
    }
</GardenCard>

@code {
    private string? _payload;

    private async Task StartAsync()
    {
        PairingKey key = PairingKey.Generate();
        await Coordinator.StartAsync(key, Guid.NewGuid());
        _payload = key.ToPayload();
    }
}
