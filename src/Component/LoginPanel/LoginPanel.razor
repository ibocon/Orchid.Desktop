@namespace Orchid.Desktop.Component
@using Garden.Share
@using Orchid.Core.Login
@using Orchid.Desktop.Service
@inject IOrchidDesktopAuthService AuthService
@inject OrchidLoginOutcomeHandler Outcome
@implements IDisposable

<section class="login-panel">
    <LoginScreen Branding="_branding">
        <ProgressIndicator>
            <GardenLoadingIndicator />
        </ProgressIndicator>
    </LoginScreen>
</section>

@code {
    /// <summary>
    /// 로그인 완료 시 부모 컴포넌트에 상태 갱신을 알리는 콜백입니다.
    /// </summary>
    [Parameter]
    public EventCallback OnAuthenticated { get; set; }

    private readonly LoginBranding _branding = OrchidLoginBranding.Create();

    protected override void OnInitialized() => Outcome.Authenticated += NotifyAuthenticatedAsync;

    private Task NotifyAuthenticatedAsync() => InvokeAsync(() => OnAuthenticated.InvokeAsync());

    /// <summary>
    /// 컴포넌트 해제 시 진행 중인 로그인 대기를 취소하고 리소스를 정리합니다.
    /// </summary>
    public void Dispose()
    {
        Outcome.Authenticated -= NotifyAuthenticatedAsync;
        AuthService.CancelSignIn();
    }
}
