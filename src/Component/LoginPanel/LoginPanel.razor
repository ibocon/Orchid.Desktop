@namespace Orchid.Desktop.Component
@using Orchid.Desktop.Service
@inject IOrchidDesktopAuthService AuthService
@inject IStringLocalizer<LoginPanelResource> Localizer
@inject DesignSystem DesignSystem

@{
    string loginButtonWidth = "80%";
    string loginButtonHeight = DesignSystem.Layout.GetPixelString(14);
    string loginButtonBorderRadius = DesignSystem.Layout.GetPixelString(4);
    string ctaMinHeight = DesignSystem.Layout.GetPixelString(36);

    string rootStyle = new StyleBuilder()
        .AddStyle("--root-gap", DesignSystem.Layout.GetPixelString(8))
        .AddStyle("--login-cta-min-height", ctaMinHeight)
        .Build();
}

<div class="root" style="@rootStyle">
    <div class="login-brand">
        <img class="login-logo"
             src="logo-login.svg"
             alt="Universal Clipboard Bridge (모두클립)" />
        <span class="login-wordmark">모두클립</span>
    </div>
    <div class="login-cta">
        @if (_isSigningIn)
        {
            <div class="login-progress"
                 role="status"
                 aria-live="polite">
                <GardenLoadingIndicator />
                <span class="login-progress__label">로그인 중...</span>
            </div>
        }
        else
        {
            <GoogleLoginButton Width="@loginButtonWidth"
                               Height="@loginButtonHeight"
                               BorderRadius="@loginButtonBorderRadius"
                               Text="@Localizer[nameof(LoginPanelResource.GoogleText)]"
                               OnClick="@(() => SignInAsync("google"))" />
            <KakaoLoginButton Width="@loginButtonWidth"
                              Height="@loginButtonHeight"
                              BorderRadius="@loginButtonBorderRadius"
                              Text="@Localizer[nameof(LoginPanelResource.KakaoText)]"
                              OnClick="@(() => SignInAsync("kakao"))" />
            <MicrosoftLoginButton Width="@loginButtonWidth"
                                  Height="@loginButtonHeight"
                                  BorderRadius="@loginButtonBorderRadius"
                                  Text="@Localizer[nameof(LoginPanelResource.MicrosoftText)]"
                                  OnClick="@(() => SignInAsync("microsoft"))" />
        }
    </div>
</div>

@code {
    /// <summary>
    /// 로그인 완료 시 부모 컴포넌트에 상태 갱신을 알리는 콜백입니다.
    /// </summary>
    [Parameter]
    public EventCallback OnAuthenticated { get; set; }

    private bool _isSigningIn;

    private async Task SignInAsync(string provider)
    {
        if (_isSigningIn)
        {
            return;
        }

        _isSigningIn = true;
        StateHasChanged();
        try
        {
            await AuthService.SignInInteractiveAsync(provider);
            await OnAuthenticated.InvokeAsync();
        }
        finally
        {
            _isSigningIn = false;
        }
    }
}
