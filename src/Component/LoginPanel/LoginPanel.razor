@namespace Orchid.Desktop.Component
@using Orchid.Desktop.Service
@inject IOrchidDesktopAuthService AuthService
@inject IStringLocalizer<LoginPanelResource> Localizer

<GardenCard Type="GardenCardType.Elevated"
            Style="max-width: 440px; margin: 32px auto; padding: 32px; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center;">
    <MudIcon Icon="@Icons.Material.Filled.LockPerson" Size="MudSize.Large" />
    <GardenTypography HtmlTag="h2" Typo="TypographyStyle.Headline" Size="TypographySize.Small">
        @Localizer[nameof(LoginPanelResource.Title)]
    </GardenTypography>
    <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
        @Localizer[nameof(LoginPanelResource.Description)]
    </GardenTypography>

    <div style="display: flex; flex-direction: column; gap: 12px; width: 100%; align-items: center; margin-top: 8px;">
        <GoogleLoginButton Width="300px"
                           Height="48px"
                           BorderRadius="12px"
                           Text="@Localizer[nameof(LoginPanelResource.GoogleText)]"
                           OnClick="@(() => SignInAsync("google"))" />
        <KakaoLoginButton Width="300px"
                          Height="48px"
                          BorderRadius="12px"
                          Text="@Localizer[nameof(LoginPanelResource.KakaoText)]"
                          OnClick="@(() => SignInAsync("kakao"))" />
        <MicrosoftLoginButton Width="300px"
                              Height="48px"
                              BorderRadius="12px"
                              Text="@Localizer[nameof(LoginPanelResource.MicrosoftText)]"
                              OnClick="@(() => SignInAsync("microsoft"))" />
    </div>
</GardenCard>

@code {
    /// <summary>
    /// 로그인 완료 시 부모 컴포넌트에 상태 갱신을 알리는 콜백입니다.
    /// </summary>
    [Parameter]
    public EventCallback OnAuthenticated { get; set; }

    private async Task SignInAsync(string provider)
    {
        await AuthService.SignInInteractiveAsync(provider);
        await OnAuthenticated.InvokeAsync();
    }
}
