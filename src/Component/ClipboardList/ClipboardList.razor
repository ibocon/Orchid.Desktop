@namespace Orchid.Desktop.Component

<div style="display: flex; flex-direction: column; gap: 12px;">
    <GardenTextField Value="@SearchQuery"
                     ValueChanged="OnSearchQueryChanged"
                     Label="클립보드 검색"
                     Placeholder="클립보드 검색..." />

    @if (Items == null || Items.Count == 0)
    {
        <GardenCard Type="GardenCardType.Outlined" Style="padding: 32px; text-align: center;">
            <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
                클립보드 기록이 없습니다.
            </GardenTypography>
        </GardenCard>
    }
    else
    {
        <GardenList>
            @foreach (ClipboardItem item in FilteredItems)
            {
                <GardenListItem>
                    <Leading>
                        <GardenChipAssist Label="@item.ContentType.ToString()"
                                          Variant="GardenChipAssistVariant.Elevated" />
                    </Leading>
                    <Headline>
                        <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
                            E2EE 암호화됨 (@item.CipherText.Length bytes)
                        </GardenTypography>
                    </Headline>
                    <Supporting>
                        <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Small">
                            @item.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")
                        </GardenTypography>
                    </Supporting>
                </GardenListItem>
            }
        </GardenList>
    }
</div>

@code {
    /// <summary>
    /// 표시할 클립보드 항목 컬렉션입니다.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ClipboardItem> Items { get; set; } = [];

    private string SearchQuery { get; set; } = string.Empty;

    private IEnumerable<ClipboardItem> FilteredItems =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? Items
            : Items.Where(i => i.ContentType.ToString().Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));

    private void OnSearchQueryChanged(string? next)
    {
        SearchQuery = next ?? string.Empty;
    }
}
