@namespace Orchid.Desktop.Component
@inject IStringLocalizer<ClipboardListResource> Localizer

@* // ✅ 대시보드 워크스페이스 헤더·필터 칩·검색바 및 아이콘 배지가 포함된 온보딩 Empty State를 제공한다 *@
<section class="clipboard-workspace">
    <div class="clipboard-workspace__header">
        <div class="clipboard-workspace__title-row">
            <GardenTypography HtmlTag="h2" Typo="TypographyStyle.Title" Size="TypographySize.Medium">
                @Localizer[nameof(ClipboardListResource.SectionTitle)]
            </GardenTypography>
            <GardenChipAssist Label="@FilteredItems.Count().ToString()"
                              Variant="GardenChipAssistVariant.Outlined" />
        </div>
        <div class="clipboard-workspace__filters">
            <GardenChipAssist Label="@Localizer[nameof(ClipboardListResource.FilterAll)]"
                              Variant="GardenChipAssistVariant.Elevated" />
            <GardenChipAssist Label="@Localizer[nameof(ClipboardListResource.FilterText)]"
                              Variant="GardenChipAssistVariant.Outlined" />
            <GardenChipAssist Label="@Localizer[nameof(ClipboardListResource.FilterImage)]"
                              Variant="GardenChipAssistVariant.Outlined" />
        </div>
    </div>

    <div class="clipboard-workspace__search">
        <GardenTextField Value="@SearchQuery"
                         ValueChanged="OnSearchQueryChanged"
                         Label="@Localizer[nameof(ClipboardListResource.SearchLabel)]"
                         Placeholder="@Localizer[nameof(ClipboardListResource.SearchPlaceholder)]" />
    </div>

    @if (Items == null || Items.Count == 0)
    {
        <GardenCard Type="GardenCardType.Outlined" Style="padding: 40px 24px;">
            <div class="clipboard-workspace__empty">
                <div class="clipboard-workspace__empty-icon">
                    <MudIcon Icon="@Icons.Material.Filled.ContentPasteSearch" Size="MudSize.Large" />
                </div>
                <GardenTypography HtmlTag="h3" Typo="TypographyStyle.Title" Size="TypographySize.Small">
                    @Localizer[nameof(ClipboardListResource.EmptyMessage)]
                </GardenTypography>
                <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
                    @Localizer[nameof(ClipboardListResource.EmptyDescription)]
                </GardenTypography>
            </div>
        </GardenCard>
    }
    else
    {
        <GardenList>
            @foreach (ClipboardItem item in FilteredItems)
            {
                <GardenListItem>
                    <Leading>
                        <GardenChipAssist Label="@item.ContentType.ToString()"
                                          Variant="GardenChipAssistVariant.Elevated" />
                    </Leading>
                    <Headline>
                        <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
                            @Localizer[nameof(ClipboardListResource.EncryptedItemFormat), item.CipherText.Length]
                        </GardenTypography>
                    </Headline>
                    <Supporting>
                        <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Small">
                            @item.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")
                        </GardenTypography>
                    </Supporting>
                </GardenListItem>
            }
        </GardenList>
    }
</section>

@code {
    /// <summary>
    /// 표시할 클립보드 항목 컬렉션입니다.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ClipboardItem> Items { get; set; } = [];

    private string SearchQuery { get; set; } = string.Empty;

    private IEnumerable<ClipboardItem> FilteredItems =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? Items
            : Items.Where(MatchesSearchQuery);

    private bool MatchesSearchQuery(ClipboardItem item)
    {
        string headline = Localizer[nameof(ClipboardListResource.EncryptedItemFormat), item.CipherText.Length];
        string timeText = item.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss");
        return item.ContentType.ToString().Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
            || headline.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
            || timeText.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase);
    }

    private void OnSearchQueryChanged(string? next)
    {
        SearchQuery = next ?? string.Empty;
    }
}
