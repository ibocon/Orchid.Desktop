<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- OrchidDesktopAuthService의 LibraryImport P/Invoke 소스 생성기에 필요하다 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Garden.Razor" />
    <PackageReference Include="Garden.Share" />
    <PackageReference Include="Orchid.Core" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\MainWindowLayout.cs" Link="MainWindowLayout.cs" />
    <Compile Include="..\..\src\Service\IOrchidDesktopAuthService.cs" Link="Service\IOrchidDesktopAuthService.cs" />
    <Compile Include="..\..\src\Service\OrchidDesktopAuthService.cs" Link="Service\OrchidDesktopAuthService.cs" />
    <Compile Include="..\..\src\Service\Localization\Language.cs" Link="Service\Localization\Language.cs" />
    <Compile Include="..\..\src\Service\Localization\LanguageCultureResolver.cs" Link="Service\Localization\LanguageCultureResolver.cs" />
  </ItemGroup>
</Project>