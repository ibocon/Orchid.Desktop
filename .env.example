# Local environment manifest for Orchid.Desktop.
#
# This tracked file is a key catalog. Never put real values here.
# .env and .env.personal are generated from OpenBao by the Garden Harness scripts.

# repository: orchid-desktop

# Plane: local repository
# Source of truth: OpenBao secret/local/orchid-desktop/dotenv
MSSTORE_APP_ID=
MSSTORE_CLIENT_ID=
MSSTORE_CLIENT_SECRET=
MSSTORE_SELLER_ID=
MSSTORE_TENANT_ID=
